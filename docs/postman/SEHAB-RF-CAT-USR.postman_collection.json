{
  "info": {
    "name": "SEHAB — RF-CAT-001, RF-CAT-002 & RF-USR-001",
    "description": "Catálogos territoriales y normativos (Res. 3100), usuarios/roles. JWT: ADMIN o GESTOR_NORMATIVO para RF-CAT-002.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sehab.gov.co\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Departamentos",
      "item": [
        {
          "name": "Listar departamentos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/departamentos?page=1&size=10&search="
          }
        },
        {
          "name": "Crear departamento",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Putumayo\",\n  \"codigo_dane\": \"86\"\n}"
            },
            "url": "{{baseUrl}}/departamentos"
          }
        },
        {
          "name": "Obtener departamento",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/departamentos/1"
          }
        },
        {
          "name": "Actualizar departamento",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Putumayo Actualizado\"\n}"
            },
            "url": "{{baseUrl}}/departamentos/1"
          }
        },
        {
          "name": "Eliminar departamento",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/departamentos/1"
          }
        }
      ]
    },
    {
      "name": "Municipios",
      "item": [
        {
          "name": "Listar municipios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/municipios?page=1&size=10&departmentId=1&search="
          }
        },
        {
          "name": "Crear municipio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departamento_id\": 1,\n  \"nombre\": \"Mocoa\",\n  \"codigo_dane\": \"86001\"\n}"
            },
            "url": "{{baseUrl}}/municipios"
          }
        },
        {
          "name": "Obtener municipio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/municipios/1"
          }
        },
        {
          "name": "Actualizar municipio",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mocoa Actualizado\"\n}"
            },
            "url": "{{baseUrl}}/municipios/1"
          }
        },
        {
          "name": "Eliminar municipio",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/municipios/1"
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/roles"
          }
        },
        {
          "name": "Crear rol",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"RES\",\n  \"descripcion\": \"Resolución 3100\",\n  \"activo\": true\n}"
            },
            "url": "{{baseUrl}}/roles"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario RES\",\n  \"email\": \"res@sehab.gov.co\",\n  \"password\": \"Res123456!\",\n  \"rol_id\": 2,\n  \"activo\": true\n}"
            },
            "url": "{{baseUrl}}/usuarios"
          }
        }
      ]
    },
    {
      "name": "RF-CAT-002 — Catálogo normativo",
      "item": [
        {
          "name": "Crear grupo servicio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"HOSP\",\n  \"nombre\": \"Hospitalización\",\n  \"descripcion\": \"Servicios de hospitalización.\"\n}"
            },
            "url": "{{baseUrl}}/grupos-servicio"
          }
        },
        {
          "name": "Crear servicio REPS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grupo_servicio_id\": 1,\n  \"codigo_reps\": \"REPS-1234\",\n  \"nombre\": \"Cirugía Mayor\",\n  \"descripcion\": \"Servicio de cirugía mayor\"\n}"
            },
            "url": "{{baseUrl}}/servicios"
          }
        },
        {
          "name": "Crear especificidad",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicio_catalogo_id\": 2,\n  \"codigo\": \"CARDIO-INT\",\n  \"nombre\": \"Cardio Integrad\"\n}"
            },
            "url": "{{baseUrl}}/especificidades"
          }
        },
        {
          "name": "Listar servicios",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/servicios?page=1&size=10&grupoId=1"
          }
        }
      ]
    }
  ]
}
